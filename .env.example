# 嵌入后端: hashing（零依赖，用于 CI/回归）| ollama（生产）
SM_EMBED_BACKEND=ollama
SM_EMBED_MODEL=bge-m3
SM_OLLAMA_BASE=http://127.0.0.1:11434

# 生成后端: none（抽取式兜底）| ollama | openai
SM_LLM_BACKEND=ollama
SM_LLM_MODEL=qwen2.5:7b

# 生成超时（秒）。本地模型冷启动要加载 2.5GB 权重，25 秒不够。
SM_LLM_TIMEOUT=60

# OpenAI 兼容接口（DeepSeek / Qwen / vLLM 都走这套）
SM_OPENAI_BASE=https://api.deepseek.com/v1
SM_OPENAI_KEY=
SM_OPENAI_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# 零依赖模式（不需要 GPU、不需要模型）：
#   SM_EMBED_BACKEND=hashing
#   SM_LLM_BACKEND=none
# 嵌入走自实现的字符 n-gram 哈希，生成走抽取式兜底。
# 换嵌入后端后索引会自动重建（索引里存了嵌入器签名）。
# ---------------------------------------------------------------------------
